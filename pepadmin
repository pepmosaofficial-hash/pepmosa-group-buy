/* ==================================================
   PAYMENT PROOF
================================================== */

function viewProof(url){

  const modal =
    document
      .getElementById("proofModal");


  const content =
    document
      .getElementById("proofContent");


  if(
    /\.(jpg|jpeg|png|gif|webp)(\?.*)?$/i
      .test(url)
  ){

    content.innerHTML =
      `<img
        src="${escapeAttr(url)}"
        alt="Payment proof"
      >`;

  }else{

    content.innerHTML =
      `<p>
        <a
          href="${escapeAttr(url)}"
          target="_blank"
        >
          OPEN PAYMENT PROOF
        </a>
      </p>`;

  }


  modal.classList.add("show");

}


function closeProof(event){

  if(
    !event ||
    event.target.id==="proofModal"
  ){

    document
      .getElementById("proofModal")
      .classList.remove("show");

  }

}


/* ==================================================
   ORDER TRACKER
================================================== */

async function updateTracker(){

  const orderId =
    document
      .getElementById("trackerOrderId")
      .value
      .trim();


  const status =
    document
      .getElementById("trackerStatus")
      .value;


  const tracking =
    document
      .getElementById("trackingNumber")
      .value
      .trim();


  const courier =
    document
      .getElementById("courier")
      .value
      .trim();


  const notes =
    document
      .getElementById("trackerNotes")
      .value
      .trim();


  const message =
    document
      .getElementById("trackerMessage");


  if(!orderId){

    message.textContent =
      "❌ Enter an Order ID.";

    return;

  }


  /*
   * Build one tracker string so it can be
   * stored in your existing ORDER TRACKER column.
   */
  let tracker =
    status;


  if(courier){

    tracker +=
      " | Courier: " +
      courier;

  }


  if(tracking){

    tracker +=
      " | Tracking: " +
      tracking;

  }


  try{

    const data =
      await apiPost({

        action:"updateTracker",

        password:
          ADMIN_PASSWORD,

        orderId:
          orderId,

        tracker:
          tracker,

        notes:
          notes

      });


    message.textContent =
      "✓ " + data.message;


  }catch(error){

    message.textContent =
      "❌ " + error.message;

  }

}


