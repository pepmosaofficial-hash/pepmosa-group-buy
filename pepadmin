<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">

<title>PEPMOSA ADMIN</title>

<style>
*{
  box-sizing:border-box;
}

body{
  margin:0;
  font-family:Arial,Helvetica,sans-serif;
  background:#f8f4f7;
  color:#302536;
}

button,
input,
select,
textarea{
  font:inherit;
}

button{
  cursor:pointer;
}

.hidden{
  display:none!important;
}

/* LOGIN */

.login-page{
  min-height:100vh;
  display:flex;
  align-items:center;
  justify-content:center;
  padding:25px;
  background:
    radial-gradient(circle at top,#fff,#f7edf3 55%,#f0e3eb);
}

.login-card{
  width:100%;
  max-width:420px;
  background:#fff;
  border-radius:24px;
  padding:40px 30px;
  box-shadow:0 20px 60px rgba(60,30,50,.12);
  text-align:center;
}

.logo{
  max-width:220px;
  max-height:100px;
  object-fit:contain;
  margin-bottom:15px;
}

.login-card h1{
  margin:0;
  font-size:25px;
  letter-spacing:2px;
}

.login-card p{
  color:#8b7b87;
  margin:8px 0 25px;
}

.login-card input{
  width:100%;
  padding:14px 16px;
  border:1px solid #ddd2da;
  border-radius:12px;
  outline:none;
  margin-bottom:12px;
}

.login-card input:focus{
  border-color:#d82f83;
}

.primary{
  border:0;
  background:#d82f83;
  color:white;
  padding:13px 20px;
  border-radius:12px;
  font-weight:bold;
}

.primary:hover{
  opacity:.9;
}

.login-status{
  margin-top:12px;
  min-height:20px;
  font-size:13px;
}

/* HEADER */

.topbar{
  background:#fff;
  border-bottom:1px solid #eadfe6;
  padding:15px 25px;
  display:flex;
  align-items:center;
  justify-content:space-between;
  position:sticky;
  top:0;
  z-index:10;
}

.brand{
  display:flex;
  align-items:center;
  gap:12px;
}

.brand img{
  height:48px;
  max-width:160px;
  object-fit:contain;
}

.brand-title{
  font-weight:bold;
  letter-spacing:1px;
}

.logout{
  border:1px solid #d82f83;
  background:white;
  color:#d82f83;
  padding:9px 14px;
  border-radius:10px;
  font-weight:bold;
}

/* MAIN */

.container{
  max-width:1250px;
  margin:auto;
  padding:25px;
}

.page-title{
  margin-bottom:20px;
}

.page-title h1{
  margin:0;
  font-size:28px;
}

.page-title p{
  margin:6px 0;
  color:#887783;
}

/* CARDS */

.card{
  background:#fff;
  border:1px solid #eadfe6;
  border-radius:18px;
  padding:20px;
  margin-bottom:20px;
  box-shadow:0 5px 20px rgba(50,25,45,.04);
}

.card h2{
  margin:0 0 15px;
  font-size:19px;
}

.card-header{
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:12px;
  margin-bottom:15px;
  flex-wrap:wrap;
}

/* STATUS */

.status-pill{
  display:inline-flex;
  align-items:center;
  gap:7px;
  padding:7px 12px;
  border-radius:999px;
  font-size:12px;
  font-weight:bold;
}

.status-open{
  background:#e9f8ee;
  color:#238044;
}

.status-closed{
  background:#fdebed;
  color:#b52e48;
}

.status-pending{
  background:#fff5db;
  color:#9a6a00;
}

.status-approved{
  background:#e9f8ee;
  color:#238044;
}

.status-rejected{
  background:#fdebed;
  color:#b52e48;
}

/* CONTROL */

.control-row{
  display:flex;
  align-items:center;
  gap:10px;
  flex-wrap:wrap;
}

.secondary{
  border:1px solid #d9ccd5;
  background:#fff;
  color:#493b46;
  padding:11px 15px;
  border-radius:10px;
  font-weight:bold;
}

.danger{
  border:0;
  background:#b93650;
  color:#fff;
  padding:11px 15px;
  border-radius:10px;
  font-weight:bold;
}

.success{
  border:0;
  background:#27864c;
  color:#fff;
  padding:11px 15px;
  border-radius:10px;
  font-weight:bold;
}

/* PAYMENT TABLE */

.table-wrap{
  overflow-x:auto;
}

table{
  width:100%;
  border-collapse:collapse;
  min-width:900px;
}

th,
td{
  padding:12px 10px;
  border-bottom:1px solid #eee5ea;
  text-align:left;
  vertical-align:top;
}

th{
  font-size:11px;
  letter-spacing:.5px;
  color:#857582;
  text-transform:uppercase;
}

td{
  font-size:13px;
}

.proof-btn{
  border:1px solid #d82f83;
  color:#d82f83;
  background:white;
  padding:7px 10px;
  border-radius:8px;
  font-size:12px;
  font-weight:bold;
}

.action-row{
  display:flex;
  gap:6px;
  flex-wrap:wrap;
}

.small-btn{
  border:0;
  padding:7px 10px;
  border-radius:8px;
  font-size:11px;
  font-weight:bold;
}

.small-green{
  background:#e8f7ed;
  color:#237c43;
}

.small-red{
  background:#fdebee;
  color:#b52e48;
}

.small-gray{
  background:#f0ebef;
  color:#564752;
}

/* FORM */

.form-grid{
  display:grid;
  grid-template-columns:repeat(2,minmax(0,1fr));
  gap:14px;
}

.field{
  display:flex;
  flex-direction:column;
  gap:6px;
}

.field.full{
  grid-column:1/-1;
}

.field label{
  font-size:12px;
  font-weight:bold;
  color:#685865;
}

.field input,
.field select,
.field textarea{
  width:100%;
  border:1px solid #ddd2da;
  border-radius:10px;
  padding:11px 12px;
  outline:none;
  background:#fff;
}

.field textarea{
  min-height:90px;
  resize:vertical;
}

.field input:focus,
.field select:focus,
.field textarea:focus{
  border-color:#d82f83;
}

/* ACCESS CODE */

.code-box{
  display:flex;
  align-items:center;
  gap:8px;
}

.code{
  background:#fff3f8;
  border:1px dashed #d82f83;
  color:#d82f83;
  padding:9px 12px;
  border-radius:9px;
  font-weight:bold;
  letter-spacing:1px;
}

/* COA */

.upload-box{
  border:2px dashed #decbd7;
  border-radius:15px;
  padding:25px;
  text-align:center;
  background:#fffafd;
}

.upload-box input{
  margin:10px 0;
}

.coa-list{
  display:grid;
  grid-template-columns:repeat(auto-fill,minmax(190px,1fr));
  gap:14px;
  margin-top:20px;
}

.coa-item{
  border:1px solid #eadfe6;
  border-radius:14px;
  overflow:hidden;
  background:#fff;
}

.coa-item img{
  width:100%;
  height:180px;
  object-fit:cover;
  display:block;
}

.coa-info{
  padding:10px;
  font-size:12px;
}

.coa-info a{
  color:#d82f83;
  font-weight:bold;
  text-decoration:none;
}

/* MODAL */

.modal{
  position:fixed;
  inset:0;
  background:rgba(35,20,30,.65);
  display:none;
  align-items:center;
  justify-content:center;
  padding:20px;
  z-index:100;
}

.modal.show{
  display:flex;
}

.modal-box{
  width:100%;
  max-width:700px;
  max-height:90vh;
  overflow:auto;
  background:#fff;
  border-radius:20px;
  padding:20px;
  position:relative;
}

.modal-close{
  position:absolute;
  top:10px;
  right:12px;
  border:0;
  background:#f2e9ef;
  width:35px;
  height:35px;
  border-radius:50%;
  font-size:20px;
}

.modal-box img{
  max-width:100%;
  max-height:70vh;
  display:block;
  margin:35px auto 0;
  object-fit:contain;
}

/* MOBILE */

@media(max-width:700px){

  .container{
    padding:15px;
  }

  .topbar{
    padding:12px 15px;
  }

  .brand img{
    max-width:120px;
    height:40px;
  }

  .form-grid{
    grid-template-columns:1fr;
  }

  .field.full{
    grid-column:auto;
  }

  .card{
    padding:15px;
  }
}
</style>
</head>

<body>

<!-- ==================================================
     LOGIN
================================================== -->

<section id="loginPage" class="login-page">

  <div class="login-card">

    <img
      src="../pepmosa-no-name.png"
      class="logo"
      alt="PEPMOSA"
      onerror="this.style.display='none'"
    >

    <h1>PEPMOSA ADMIN</h1>

    <p>Authorized access only</p>

    <input
      id="adminPassword"
      type="password"
      placeholder="Enter admin password"
      autocomplete="current-password"
      onkeydown="if(event.key==='Enter') adminLogin()"
    >

    <button
      class="primary"
      style="width:100%"
      onclick="adminLogin()"
    >
      LOGIN
    </button>

    <div
      id="loginStatus"
      class="login-status"
    ></div>

  </div>

</section>


<!-- ==================================================
     DASHBOARD
================================================== -->

<section id="dashboard" class="hidden">

  <header class="topbar">

    <div class="brand">

      <img
        src="../pepmosa-no-name.png"
        alt="PEPMOSA"
        onerror="this.style.display='none'"
      >

      <div class="brand-title">
        ADMIN DASHBOARD
      </div>

    </div>

    <button
      class="logout"
      onclick="logout()"
    >
      LOGOUT
    </button>

  </header>


  <main class="container">

    <div class="page-title">

      <h1>PEPMOSA ADMIN</h1>

      <p>
        Manage admin fees, access codes,
        orders, tracking and COA.
      </p>

    </div>


    <!-- ==================================================
         GROUP BUY CONTROL
    ================================================== -->

    <div class="card">

      <div class="card-header">

        <h2>🔒 GROUP BUY CONTROL</h2>

        <span
          id="groupBuyStatus"
          class="status-pill status-open"
        >
          ● CHECKING
        </span>

      </div>

      <p style="color:#81737d;font-size:13px;">
        Closing the group buy prevents new
        ₱180 admin-fee requests from being submitted.
      </p>

      <div class="control-row">

        <button
          class="success"
          onclick="setGroupBuy(true)"
        >
          🟢 OPEN ADMIN FEE
        </button>

        <button
          class="danger"
          onclick="setGroupBuy(false)"
        >
          🔴 CLOSE ADMIN FEE
        </button>

        <button
          class="secondary"
          onclick="loadGroupBuyStatus()"
        >
          ↻ REFRESH
        </button>

      </div>

      <div
        id="groupBuyMessage"
        style="margin-top:10px;font-size:13px;"
      ></div>

    </div>


    <!-- ==================================================
         ADMIN FEE PAYMENTS
    ================================================== -->

    <div class="card">

      <div class="card-header">

        <h2>💳 ADMIN FEE PAYMENTS</h2>

        <div class="control-row">

          <select
            id="paymentFilter"
            class="secondary"
            onchange="loadPayments()"
          >
            <option value="PENDING">PENDING</option>
            <option value="APPROVED">APPROVED</option>
            <option value="REJECTED">REJECTED</option>
            <option value="ALL">ALL</option>
          </select>

          <button
            class="secondary"
            onclick="loadPayments()"
          >
            ↻ REFRESH
          </button>

        </div>

      </div>


      <div class="table-wrap">

        <table>

          <thead>

            <tr>
              <th>Reference</th>
              <th>Customer</th>
              <th>Email</th>
              <th>Telegram</th>
              <th>Fee</th>
              <th>Status</th>
              <th>Proof</th>
              <th>Access Code</th>
              <th>Actions</th>
            </tr>

          </thead>

          <tbody id="paymentsBody">

            <tr>
              <td colspan="9">
                Loading...
              </td>
            </tr>

          </tbody>

        </table>

      </div>

    </div>


    <!-- ==================================================
         ORDER TRACKER
    ================================================== -->

    <div class="card">

      <div class="card-header">

        <h2>📦 ORDER TRACKER</h2>

        <button
          class="secondary"
          onclick="clearTrackerForm()"
        >
          CLEAR
        </button>

      </div>


      <div class="form-grid">

        <div class="field">

          <label>ORDER ID</label>

          <input
            id="trackerOrderId"
            placeholder="Example: PEP-001"
          >

        </div>


        <div class="field">

          <label>ORDER STATUS</label>

          <select id="trackerStatus">

            <option value="ADMIN FEE APPROVED">
              ADMIN FEE APPROVED
            </option>

            <option value="ORDER CONFIRMED">
              ORDER CONFIRMED
            </option>

            <option value="ORDER PROCESSING">
              ORDER PROCESSING
            </option>

            <option value="ORDER PACKED">
              ORDER PACKED
            </option>

            <option value="SHIPPED">
              SHIPPED
            </option>

            <option value="IN TRANSIT">
              IN TRANSIT
            </option>

            <option value="OUT FOR DELIVERY">
              OUT FOR DELIVERY
            </option>

            <option value="DELIVERED">
              DELIVERED
            </option>

            <option value="COMPLETED">
              COMPLETED
            </option>

          </select>

        </div>


        <div class="field">

          <label>TRACKING NUMBER</label>

          <input
            id="trackingNumber"
            placeholder="Enter tracking number"
          >

        </div>


        <div class="field">

          <label>COURIER</label>

          <input
            id="courier"
            placeholder="UPS / J&T / LBC / etc."
          >

        </div>


        <div class="field full">

          <label>TRACKING / ORDER NOTE</label>

          <textarea
            id="trackerNotes"
            placeholder="Enter any update for the customer..."
          ></textarea>

        </div>

      </div>


      <div style="margin-top:15px;">

        <button
          class="primary"
          onclick="updateTracker()"
        >
          SAVE ORDER UPDATE
        </button>

      </div>


      <div
        id="trackerMessage"
        style="margin-top:10px;font-size:13px;"
      ></div>

    </div>


    <!-- ==================================================
         COA
    ================================================== -->

    <div class="card">

      <div class="card-header">

        <h2>🧪 CERTIFICATE OF ANALYSIS</h2>

        <button
          class="secondary"
          onclick="loadCOA()"
        >
          ↻ REFRESH
        </button>

      </div>


      <div class="upload-box">

        <strong>
          UPLOAD COA IMAGE
        </strong>

        <br>

        <input
          id="coaFile"
          type="file"
          accept="image/*,.pdf"
        >

        <br>

        <button
          class="primary"
          onclick="uploadCOA()"
        >
          UPLOAD COA
        </button>

        <div
          id="coaMessage"
          style="margin-top:10px;font-size:13px;"
        ></div>

      </div>


      <div
        id="coaList"
        class="coa-list"
      ></div>

    </div>

  </main>

</section>


<!-- ==================================================
     PROOF MODAL
================================================== -->

<div
  id="proofModal"
  class="modal"
  onclick="closeProof(event)"
>

  <div class="modal-box">

    <button
      class="modal-close"
      onclick="closeProof()"
    >
      ×
    </button>

    <h2>PAYMENT PROOF</h2>

    <div id="proofContent"></div>

  </div>

</div>


<script>

/* ==================================================
   CONFIG
================================================== */

const API_URL =
"https://script.google.com/macros/s/AKfycbxiLGefHwEY5hSA865kJLG8oG_2RxHXgewGE9mUng5r0xHmJqbxZxSGoypwzNn9TRs/exec";


let ADMIN_PASSWORD = "";

let isLoggedIn = false;


/* ==================================================
   API
================================================== */

async function apiPost(payload){

  const response =
    await fetch(API_URL,{
      method:"POST",
      headers:{
        "Content-Type":"text/plain;charset=utf-8"
      },
      body:JSON.stringify(payload)
    });

  const text =
    await response.text();

  let data;

  try{
    data=JSON.parse(text);
  }catch(error){
    throw new Error(
      "Invalid response from Apps Script."
    );
  }

  if(data.success === false){
    throw new Error(
      data.message || "Request failed."
    );
  }

  return data;
}


async function apiGet(params){

  const url =
    API_URL +
    "?" +
    new URLSearchParams(params).toString();

  const response =
    await fetch(url);

  const text =
    await response.text();

  let data;

  try{
    data=JSON.parse(text);
  }catch(error){
    throw new Error(
      "Invalid response from Apps Script."
    );
  }

  if(data.success === false){
    throw new Error(
      data.message || "Request failed."
    );
  }

  return data;
}


/* ==================================================
   LOGIN
================================================== */

async function adminLogin(){

  const password =
    document
      .getElementById("adminPassword")
      .value
      .trim();


  const status =
    document
      .getElementById("loginStatus");


  if(!password){

    status.textContent =
      "Please enter the admin password.";

    return;
  }


  status.textContent =
    "Checking password...";


  try{

    await apiPost({

      action:"adminLogin",

      password:password

    });


    ADMIN_PASSWORD =
      password;

    isLoggedIn=true;


    sessionStorage.setItem(
      "PEPMOSA_ADMIN_PASSWORD",
      password
    );


    document
      .getElementById("loginPage")
      .classList.add("hidden");


    document
      .getElementById("dashboard")
      .classList.remove("hidden");


    status.textContent="";


    loadEverything();


  }catch(error){

    status.textContent =
      "❌ " + error.message;

  }

}


function logout(){

  ADMIN_PASSWORD="";

  isLoggedIn=false;

  sessionStorage.removeItem(
    "PEPMOSA_ADMIN_PASSWORD"
  );


  document
    .getElementById("dashboard")
    .classList.add("hidden");


  document
    .getElementById("loginPage")
    .classList.remove("hidden");


  document
    .getElementById("adminPassword")
    .value="";

}


/* ==================================================
   AUTO LOGIN
================================================== */

window.addEventListener(
  "DOMContentLoaded",
  function(){

    const saved =
      sessionStorage.getItem(
        "PEPMOSA_ADMIN_PASSWORD"
      );


    if(saved){

      document
        .getElementById("adminPassword")
        .value=saved;

      adminLogin();

    }

  }
);


/* ==================================================
   LOAD EVERYTHING
================================================== */

function loadEverything(){

  loadGroupBuyStatus();

  loadPayments();

  loadCOA();

}


/* ==================================================
   GROUP BUY
================================================== */

async function loadGroupBuyStatus(){

  try{

    const data =
      await apiGet({

        action:"groupBuyStatus"

      });


    renderGroupBuyStatus(
      data.open
    );


  }catch(error){

    document
      .getElementById("groupBuyStatus")
      .textContent =
      "ERROR";

  }

}


function renderGroupBuyStatus(open){

  const el =
    document
      .getElementById("groupBuyStatus");


  if(open){

    el.className =
      "status-pill status-open";

    el.textContent =
      "● ADMIN FEE OPEN";

  }else{

    el.className =
      "status-pill status-closed";

    el.textContent =
      "● ADMIN FEE CLOSED";

  }

}


async function setGroupBuy(open){

  if(
    !confirm(
      open
      ? "Open admin-fee payments?"
      : "Close admin-fee payments?"
    )
  ){
    return;
  }


  const message =
    document
      .getElementById("groupBuyMessage");


  try{

    const data =
      await apiPost({

        action:"setGroupBuy",

        password:
          ADMIN_PASSWORD,

        open:open

      });


    renderGroupBuyStatus(
      data.open
    );


    message.textContent =
      data.message;


  }catch(error){

    message.textContent =
      "❌ " + error.message;

  }

}


/* ==================================================
   PAYMENTS
================================================== */

async function loadPayments(){

  const body =
    document
      .getElementById("paymentsBody");


  body.innerHTML =
    "<tr><td colspan='9'>Loading...</td></tr>";


  try{

    const status =
      document
        .getElementById("paymentFilter")
        .value;


    const data =
      await apiGet({

        action:"adminList",

        password:
          ADMIN_PASSWORD,

        status:status

      });


    renderPayments(
      data.items || []
    );


  }catch(error){

    body.innerHTML =
      `<tr>
        <td colspan="9">
          ❌ ${escapeHtml(error.message)}
        </td>
      </tr>`;

  }

}


function renderPayments(items){

  const body =
    document
      .getElementById("paymentsBody");


  if(!items.length){

    body.innerHTML =
      `<tr>
        <td colspan="9">
          No payment requests found.
        </td>
      </tr>`;

    return;
  }


  body.innerHTML =
    items.map(function(item){

      const statusClass =
        item.status==="APPROVED"
        ? "status-approved"
        : item.status==="REJECTED"
        ? "status-rejected"
        : "status-pending";


      let accessCode =
        item.accessCode
        ? `<div class="code-box">
            <span class="code">
              ${escapeHtml(item.accessCode)}
            </span>
            <button
              class="small-btn small-gray"
              onclick="copyCode('${escapeAttr(item.accessCode)}')"
            >
              COPY
            </button>
          </div>`
        : "—";


      let actions="";


      if(item.status==="PENDING"){

        actions =
          `<div class="action-row">

            <button
              class="small-btn small-green"
              onclick="approvePayment('${escapeAttr(item.reference)}')"
            >
              ✓ APPROVE
            </button>

            <button
              class="small-btn small-red"
              onclick="rejectPayment('${escapeAttr(item.reference)}')"
            >
              ✕ REJECT
            </button>

          </div>`;

      }else{

        actions="—";

      }


      return `
      <tr>

        <td>
          <strong>
            ${escapeHtml(item.reference)}
          </strong>
          <br>
          <small>
            ${escapeHtml(item.date || "")}
          </small>
        </td>

        <td>
          ${escapeHtml(item.fullname)}
          <br>
          <small>
            ${escapeHtml(item.contact)}
          </small>
        </td>

        <td>
          ${escapeHtml(item.email)}
        </td>

        <td>
          ${escapeHtml(item.telegram)}
        </td>

        <td>
          ₱${escapeHtml(item.payment)}
        </td>

        <td>
          <span class="status-pill ${statusClass}">
            ${escapeHtml(item.status)}
          </span>
        </td>

        <td>
          ${
            item.proof
            ? `<button
                class="proof-btn"
                onclick="viewProof('${escapeAttr(item.proof)}')"
              >
                VIEW
              </button>`
            : "—"
          }
        </td>

        <td>
          ${accessCode}
        </td>

        <td>
          ${actions}
        </td>

      </tr>
      `;

    }).join("");

}


