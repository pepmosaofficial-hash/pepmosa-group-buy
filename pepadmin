}


/* ==================================================
   COA
================================================== */

async function uploadCOA(){

  const input =
    document
      .getElementById("coaFile");


  const message =
    document
      .getElementById("coaMessage");


  if(!input.files.length){

    message.textContent =
      "❌ Select a COA file first.";

    return;

  }


  const file =
    input.files[0];


  if(
    file.size >
    10 * 1024 * 1024
  ){

    message.textContent =
      "❌ File must be 10MB or smaller.";

    return;

  }


  message.textContent =
    "Uploading COA...";


  try{

    const dataUrl =
      await fileToDataURL(file);


    const data =
      await apiPost({

        action:"uploadCOA",

        password:
          ADMIN_PASSWORD,

        fileName:
          file.name,

        file:
          dataUrl

      });


    message.textContent =
      "✓ " + data.message;


    input.value="";


    loadCOA();


  }catch(error){

    message.textContent =
      "❌ " + error.message;

  }

}


async function loadCOA(){

  const list =
    document
      .getElementById("coaList");


  list.innerHTML =
    "<div>Loading COAs...</div>";


  try{

    const data =
      await apiGet({

        action:"listCOA",

        password:
          ADMIN_PASSWORD

      });


    const items =
      data.items || [];


    if(!items.length){

      list.innerHTML =
        "<div>No COA uploaded yet.</div>";

      return;

    }


    list.innerHTML =
      items.map(function(item){

        const isImage =
          /\.(jpg|jpeg|png|gif|webp)$/i
            .test(item.fileName);


        return `
        <div class="coa-item">

          ${
            isImage
            ? `<img
                src="${escapeAttr(item.url)}"
                alt="${escapeAttr(item.fileName)}"
              >`
            : `<div style="
                height:180px;
                display:flex;
                align-items:center;
                justify-content:center;
                background:#f8f2f6;
                font-size:40px;
              ">
                📄
              </div>`
          }

          <div class="coa-info">

            <strong>
              ${escapeHtml(item.fileName)}
            </strong>

            <br>

            <small>
              ${escapeHtml(item.date || "")}
            </small>

            <br><br>

            <a
              href="${escapeAttr(item.url)}"
              target="_blank"
            >
              VIEW COA
            </a>

          </div>

        </div>
        `;

      }).join("");


  }catch(error){

    list.innerHTML =
      `<div>
        ❌ ${escapeHtml(error.message)}
      </div>`;

  }

}


/* ==================================================
   FILE READER
================================================== */

function fileToDataURL(file){

  return new Promise(
    function(resolve,reject){

      const reader =
        new FileReader();

      reader.onload =
        function(){
          resolve(reader.result);
        };

      reader.onerror =
        function(){
          reject(
            new Error(
              "Could not read file."
            )
          );
        };

      reader.readAsDataURL(file);

    }
  );

}


/* ==================================================
   SECURITY / DISPLAY HELPERS
================================================== */

function escapeHtml(value){

  return String(value ?? "")
    .replace(
      /[&<>"']/g,
      function(char){

        return {
          "&":"&amp;",
          "<":"&lt;",
          ">":"&gt;",
          '"':"&quot;",
          "'":"&#039;"
        }[char];

      }
    );

}


function escapeAttr(value){

  return String(value ?? "")
    .replace(
      /\\/g,
      "\\\\"
    )
    .replace(
      /'/g,
      "\\'"
    )
    .replace(
      /"/g,
      "&quot;"
    );

}

